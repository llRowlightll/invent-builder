# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Product PDFs (too large for git – stored locally at docs/pdfs/)
docs/pdfs/**/*.pdf
docs/pdfs/**/*.zip

# Machine-local Claude Code preview config (absolute paths, per-machine).
# Untracked so `git reset` never clobbers each developer's local launch path.
.claude/launch.json

# Tillverkarkataloger — källdokument, inte kod. Stora binärer hör inte i git.
docs/kataloger/

# Lokala byggartefakter som aldrig ska versionshanteras.
# .vite/ är Vites cache, __pycache__/ Pythons.
# deno.lock skrivs av varje `deno test`/`deno check` som körs UTAN --no-lock;
# CI kör alltid med --no-lock (se edge-deploy.yml), så filen har ingen roll
# här och skulle bara ge konflikter mellan maskiner.
.vite/
__pycache__/
deno.lock
