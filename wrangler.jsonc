{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maskinval",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "routes": [
    { "pattern": "maskinval.se/*", "zone_name": "maskinval.se" },
    { "pattern": "www.maskinval.se/*", "zone_name": "maskinval.se" }
  ]
}
